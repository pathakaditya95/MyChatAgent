# Template only — placeholders, never real values.
# Copy to .env and fill it in:  cp .env.example .env
# .env is gitignored; this file is NOT, so nothing secret may live here.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/metaautoreply
DB_USER=meta
DB_PASSWORD=meta

# --- Server -----------------------------------------------------------------
PORT=8080

# --- Meta app credentials (Phase 0 outputs) ---------------------------------
# Facebook App Secret: App Settings -> Basic -> App Secret. Signs Page deliveries.
META_APP_SECRET=changeme-app-secret
# Instagram App Secret, from the Instagram product settings. Only needed when the
# app uses Instagram API with Instagram Login, which signs Instagram deliveries
# with a DIFFERENT secret from the Facebook one. Leave blank for a Page-only app.
META_INSTAGRAM_APP_SECRET=
# A random string you choose yourself — Meta does not issue this. The exact same
# value goes in the Meta dashboard's webhook "Verify token" field.
# Generate one with: openssl rand -hex 16
META_VERIFY_TOKEN=changeme-verify-token
# System User access token, generated with "never expires" selected.
META_ACCESS_TOKEN=changeme-access-token
# Numeric Facebook Page ID.
META_PAGE_ID=000000000000000
# Numeric Instagram Business Account ID.
META_IG_USER_ID=000000000000000

# Graph API version to target.
META_GRAPH_VERSION=v21.0
# Keep true until Phase 11. When true no live Graph API calls are made.
META_DRY_RUN=true

# --- Admin API (Phase 9) ----------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=changeme-admin-password

# --- Cloudflare tunnel (Phase 5, optional) ----------------------------------
# Only needed for a *named* tunnel. A quick tunnel needs no token.
TUNNEL_TOKEN=
